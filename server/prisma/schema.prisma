generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// 用户角色枚举
enum UserRole {
  CLIENT      // 当事人
  WINGMAN     // 军师
  ADMIN       // 管理员
}

// 关系阶段枚举
enum RelationshipStatus {
  MATCHING    // 牵线期
  ICEBREAKING // 破冰期
  FLIRTING    // 暧昧期
  ENDED       // 已结束
}

// 军师介入模式枚举
enum WingmanMode {
  SOLO        // 代聊模式
  PRIVATE     // 私聊模式
  ASSIST      // 辅助模式
}

// 军师任务状态枚举
enum TaskStatus {
  OPEN        // 开放接取
  ASSIGNED    // 已分配
  IN_PROGRESS // 进行中
  COMPLETED   // 已完成
  CANCELLED   // 已取消
}

// 军师申请状态枚举
enum ApplicationStatus {
  PENDING     // 待审批
  APPROVED    // 已通过
  REJECTED    // 已拒绝
}

// 帖子状态枚举
enum PostStatus {
  ACTIVE
  CLOSED
}

// 消息类型枚举
enum MessageType {
  MAIN        // 主窗口消息
  PRIVATE     // 私聊消息（当事人↔己方军师）
  PENDING     // 待确认消息（军师草拟，辅助模式）
  SYSTEM      // 系统消息
}

// 牵线请求状态枚举
enum MatchRequestStatus {
  PENDING     // 待处理
  ACCEPTED    // 已接受
  REJECTED    // 已拒绝
  EXPIRED     // 已过期
}

// 军师认证状态枚举
enum WingmanCertStatus {
  NONE        // 未申请
  PENDING     // 审核中
  APPROVED    // 已通过
  REJECTED    // 已驳回
}

// ==================== 用户 ====================
model User {
  id           String   @id @default(cuid())
  email        String   @unique          // 南大校园邮箱（不可修改）
  contactEmail String?                   // 常用邮箱
  nickname     String                    // 昵称
  password     String                    // 加密密码
  avatar       String?                   // 头像URL
  gender       String?                   // 性别
  campus       String?                   // 校区
  grade        String?                   // 年级
  major        String?                   // 专业
  interests    String[]                  // 兴趣标签
  declaration  String?                   // 恋爱宣言
  cardImage    String?                   // 个性卡片图片
  creditScore  Int      @default(0)     // 信用分
  isActive     Boolean  @default(true)  // 是否活跃
  lastActiveAt DateTime @default(now()) // 最后活跃时间
  roles        UserRole[]               // 用户角色（可双重）
  wingmanCertStatus  WingmanCertStatus @default(NONE) // 军师认证状态
  wingmanCertCooldown DateTime?         // 军师认证失败冷却截止时间
  wechat        String?                 // 微信（隐藏）
  qq           String?                  // QQ（隐藏）
  phone        String?                 // 手机号（隐藏）
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // 作为当事人1的关系
  relationshipsAsUser1 Relationship[] @relation("User1Relationships")
  // 作为当事人2的关系
  relationshipsAsUser2 Relationship[] @relation("User2Relationships")
  // 作为当事人发布的军师任务
  wingmanTasksClient  WingmanTask[]  @relation("ClientTasks")
  // 作为军师接取的任务
  wingmanTasksWingman WingmanTask[]  @relation("WingmanTasks")
  // 军师申请记录
  wingmanApplications WingmanApplication[]
  // 军师分配记录
  wingmanAssignments  WingmanAssignment[]
  // 发送的消息
  sentMessages   Message[]
  // 发布的帖子
  posts          Post[]
  // 帖子回复
  postReplies    PostReply[]
  // 作为目标的私聊消息
  targetedMessages Message[] @relation("TargetedMessages")
  // 发出的牵线请求
  sentMatchRequests     MatchRequest[] @relation("SentRequests")
  // 收到的牵线请求
  receivedMatchRequests MatchRequest[] @relation("ReceivedRequests")
  // 签到记录
  checkinRecords CheckinRecord[]
  // 收到的信用分调整
  creditLogs     CreditLog[]
  // 管理员操作记录
  adminActions   CreditLog[] @relation("AdminActions")
  // 收到的通知
  notifications  Notification[]
}

// ==================== 关系（牵线/破冰/暧昧） ====================
model Relationship {
  id         String             @id @default(cuid())
  user1Id    String                             // 当事人1
  user2Id    String                             // 当事人2
  status     RelationshipStatus @default(MATCHING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  user1      User               @relation("User1Relationships", fields: [user1Id], references: [id])
  user2      User               @relation("User2Relationships", fields: [user2Id], references: [id])
  wingmen      WingmanAssignment[]
  wingmanTasks WingmanTask[]
  messages     Message[]
  ratings      Rating[]

  @@unique([user1Id, user2Id])
}

// ==================== 军师分配 ====================
model WingmanAssignment {
  id             String      @id @default(cuid())
  relationshipId String
  userId         String                       // 军师用户ID
  side           Int                           // 1=当事人1的军师, 2=当事人2的军师
  mode           WingmanMode @default(PRIVATE)
  joinedAt       DateTime    @default(now())
  leftAt         DateTime?

  relationship   Relationship @relation(fields: [relationshipId], references: [id])
  user           User         @relation(fields: [userId], references: [id])

  @@unique([relationshipId, side])
}

// ==================== 军师任务（大厅） ====================
model WingmanTask {
  id             String       @id @default(cuid())
  clientId       String                        // 当事人ID
  relationshipId String?                       // 关联的关系ID
  title          String                        // 任务标题
  description    String                        // 任务描述
  status         TaskStatus   @default(OPEN)
  wingmanId      String?                       // 最终选中的军师ID
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  client         User         @relation("ClientTasks", fields: [clientId], references: [id])
  wingman        User?        @relation("WingmanTasks", fields: [wingmanId], references: [id])
  relationship   Relationship? @relation(fields: [relationshipId], references: [id])
  applications   WingmanApplication[]
}

// ==================== 军师申请 ====================
model WingmanApplication {
  id        String            @id @default(cuid())
  taskId    String
  wingmanId String
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime          @default(now())

  task      WingmanTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  wingman   User        @relation(fields: [wingmanId], references: [id])

  @@unique([taskId, wingmanId])
}

// ==================== 消息 ====================
model Message {
  id             String      @id @default(cuid())
  relationshipId String
  senderId       String
  content        String                       // 消息内容（文字/表情标识符）
  type           MessageType @default(MAIN)   // 消息类型
  targetUserId   String?                      // PRIVATE 消息的目标用户
  isSystem       Boolean     @default(false)  // 是否为系统消息
  requireConfirm Boolean     @default(false)  // 辅助模式：需当事人确认
  confirmed      Boolean     @default(false)  // 是否已确认
  createdAt      DateTime    @default(now())

  relationship   Relationship @relation(fields: [relationshipId], references: [id])
  sender         User         @relation(fields: [senderId], references: [id])
  targetUser     User?        @relation("TargetedMessages", fields: [targetUserId], references: [id])

  @@index([relationshipId, createdAt])
}

// ==================== 牵线请求 ====================
model MatchRequest {
  id         String             @id @default(cuid())
  fromUserId String                              // 发起方
  toUserId   String                              // 目标方
  status     MatchRequestStatus @default(PENDING)
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  fromUser   User               @relation("SentRequests", fields: [fromUserId], references: [id])
  toUser     User               @relation("ReceivedRequests", fields: [toUserId], references: [id])

  @@index([toUserId, status])
  @@index([fromUserId, status])
}

// ==================== 评价 ====================
model Rating {
  id             String   @id @default(cuid())
  relationshipId String
  fromUserId     String                       // 评价人
  toUserId       String                       // 被评价人
  score          Int                          // -1, 1, 2, 3
  comment        String?
  createdAt      DateTime @default(now())

  relationship   Relationship @relation(fields: [relationshipId], references: [id])

  @@unique([relationshipId, fromUserId, toUserId])
}

// ==================== 帖子大厅 ====================
model Post {
  id         String       @id @default(cuid())
  authorId   String
  title      String
  content    String
  status     PostStatus   @default(ACTIVE)
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  author     User         @relation(fields: [authorId], references: [id])
  replies    PostReply[]
}

model PostReply {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post      Post     @relation(fields: [postId], references: [id])
  author    User     @relation(fields: [authorId], references: [id])

  @@index([postId, createdAt])
}

// ==================== 签到记录 ====================
model CheckinRecord {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// ==================== 信用分调整日志 ====================
model CreditLog {
  id        String   @id @default(cuid())
  userId    String                        // 被调整的用户
  adminId   String                        // 执行调整的管理员
  amount    Int                           // 正数增加，负数扣减
  reason    String                        // 调整原因
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])
  admin     User     @relation("AdminActions", fields: [adminId], references: [id])

  @@index([userId, createdAt])
  @@index([adminId, createdAt])
}

// ==================== 通知 ====================
model Notification {
  id        String   @id @default(cuid())
  userId    String                        // 接收通知的用户
  type      String                        // 通知类型
  title     String                        // 通知标题
  content   String?                       // 通知内容
  data      Json?                         // 附加数据（关系ID、用户ID等）
  read      Boolean  @default(false)      // 是否已读
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}
