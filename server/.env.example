# Environment Variables

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/violet?schema=public"

# Redis
REDIS_HOST="localhost"
REDIS_PORT=6379

# Mail (NJU email verification)
SMTP_HOST="smtp.nju.edu.cn"
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER="your_email@smail.nju.edu.cn"
SMTP_PASS="your_password"

# JWT
JWT_SECRET="your-secret-key"

# App
APP_PORT=3000
