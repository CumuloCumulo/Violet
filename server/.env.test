# 本地测试 + 服务器数据库 (通过 SSH 隧道)
# 使用方法: cp .env.remote-test .env.test && pnpm --filter server dev
# 前提: SSH 隧道已建立 (见下方命令)

# Database — 通过隧道连接服务器 PostgreSQL
DATABASE_URL="postgresql://violet:violet2026@localhost:15432/violet?schema=public"

# Redis — 通过隧道连接服务器 Redis
REDIS_HOST="localhost"
REDIS_PORT=16379

# JWT — 使用生产 JWT secret 以兼容
JWT_SECRET="violet-prod-jwt-secret-e5e97edfb24b59d925716b462399b88f1"

# App
PORT=3000

# CORS — 允许本地前端
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# SMTP (placeholder)
SMTP_HOST=smtp.nju.edu.cn
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=placeholder@smail.nju.edu.cn
SMTP_PASS=placeholder
